library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
library work;
use work.VgaTypes.all;


entity Vga is 
    generic(SystemFreq : integer := 40000000;
            VsyncFreq : integer := 60;
            HsyncFreq : integer := 37680);

    port(Reset_n : in std_logic := '1';
         ColorClk : in std_logic  := '0';
         HsyncClk : out std_logic := '0';
         VsyncClk : out std_logic := '0';
         R_0      : out std_logic := '0';
         R_1      : out std_logic := '0';
         R_2      : out std_logic := '0';
         G_0      : out std_logic := '0';
         G_1      : out std_logic := '0';
         G_2      : out std_logic := '0';
         B_0      : out std_logic := '0';
         B_1      : out std_logic := '0';
         B_2      : out std_logic := '0';
         LineCycle : out std_logic := '0';
         LineColor : in LineColor_t := (others => (others => '0'));
         x_axis   : inout unsigned(9 downto 0) := (others => '0');
         y_axis   : inout unsigned(9 downto 0) := (others => '0'));

end Vga;

architecture rtl of Vga is
    constant VsyncPeriod : integer := 666666;
    constant HsyncPeriod : integer := 1056;
    constant VsyncDuty : integer := 4267;
    constant HsyncDuty : integer := 128;
    constant HsyncBackPorch: integer := 168;
    constant HsyncPixel : integer := 968;

    signal HsyncCounter : integer := 0;
    signal VsyncCounter : integer := 0;
    signal ColorClk_reg : std_logic := '0';
    signal HsyncClk_reg : std_logic := '0';
    signal VsyncClk_reg : std_logic := '0';

    type Sync_State is 
        (
            IDLE_STATE,
            PULSE_STATE,
            BACK_PORCH_STATE,
            WAIT_STATE,
            EXTEND_STATE,
            FRONT_PORCH
        );

    signal HsyncState : Sync_State := IDLE_STATE;
    signal VsyncState : Sync_State := IDLE_STATE;

begin
    --Hsync pulse process
    process(ColorClk, Reset_n) is
    begin
        if (Reset_n = '0') then
            HsyncCounter <= 0;
            HsyncClk_reg <= '0';
        elsif rising_edge(ColorClk) then --Here we should increase the counter
            case HsyncState is
                when IDLE_STATE =>
                    HsyncState <= PULSE_STATE;
                    HsyncClk_reg <= '1';

                when PULSE_STATE =>
                    if (HsyncCounter = HsyncDuty) then
                        HsyncState <= BACK_PORCH_STATE;
                        HsyncClk_reg <= '0';
                    end if;
                    HsyncCounter <= HsyncCounter+1;

                when BACK_PORCH_STATE =>
                    if (HsyncCounter = HsyncBackPorch) then
                        HsyncState <= WAIT_STATE;
                    end if;
                    HsyncCounter <= HsyncCounter+1;


                when WAIT_STATE =>
                    if (HsyncCounter = HsyncPixel ) then
                        HsyncState <= FRONT_PORCH;
                    else
                        -- 0x320 = 800
                        if (x_axis<X"320"") then
                        x_axis <= x_axis + 1;
                        end if;
                    end if;
                    HsyncCounter <= HsyncCounter+1;

                when FRONT_PORCH =>
                    if (HsyncCounter = HsyncPeriod ) then
                        if (VsyncCounter >= VsyncPeriod)  then
                            y_axis <= (others => '0');
                        else
                            -- 0x274 = 628 
                            if (y_axis < X"274") then
                                y_axis <= y_axis+1;
                            else
                             --remain the same
                            end if;
                        end if;
                        HsyncCounter <= 0;
                        HsyncState <= PULSE_STATE;
                        x_axis <= (others => '0');
                        HsyncClk_reg <= '1';
                    else
                        HsyncCounter <= HsyncCounter+1;
                    end if;
                when others => null;
            end case;
        end if;
    end process;

    --Vsync pulse process
    process(ColorClk, Reset_n) is
    begin
        if (Reset_n = '0') then
            VsyncCounter <= 0;
            VsyncClk_reg <= '0';
        elsif (ColorClk'event and ColorClk = '1') then --Here we should increase the counter
            case VsyncState is
                when IDLE_STATE =>
                    VsyncState <= PULSE_STATE;
                    VsyncClk_reg <= '1';

                when PULSE_STATE =>
                    if (VsyncCounter = VsyncDuty) then
                        VsyncState <= WAIT_STATE;
                        VsyncClk_reg <= '0';
                    end if;
                    VsyncCounter <= VsyncCounter+1;

                when WAIT_STATE =>
                    if (VsyncCounter = VsyncPeriod) then
                        if (HsyncCounter < HsyncPeriod) then
                            VsyncState <= EXTEND_STATE;
                        else
                            VsyncCounter <= 0;
                            VsyncState <= PULSE_STATE;
                            VsyncClk_reg <= '1';
                        end if;
                    else
                        VsyncCounter <= VsyncCounter+1;
                    end if;
                    
                when EXTEND_STATE =>
                    if (HsyncCounter = HsyncPeriod) then
                        VsyncCounter <= 0;
                        VsyncState <= PULSE_STATE;
                        VsyncClk_reg <= '1';
                    end if;

                when others => null;
            end case;
        end if;
    end process;
	
    --color pulse process much more complicated
    process(ColorClk, Reset_n) is
    begin
        if (Reset_n = '0') then
            R_0 <= '0';
            R_1 <= '0';
            R_2 <= '0';
            G_0 <= '0';
            G_1 <= '0';
            G_2 <= '0';
            B_0 <= '0';
            B_1 <= '0';
            B_2 <= '0';
        elsif (ColorClk'event and ColorClk = '1') then --Here we should increase the counter
            R_0 <= LineColor(to_integer(x_axis), 0);
            R_1 <= LineColor(to_integer(x_axis), 1);
            R_2 <= LineColor(to_integer(x_axis), 2);
            G_0 <= LineColor(to_integer(x_axis), 3);
            G_1 <= LineColor(to_integer(x_axis), 4);
            G_2 <= LineColor(to_integer(x_axis), 5);
            B_0 <= LineColor(to_integer(x_axis), 6);
            B_1 <= LineColor(to_integer(x_axis), 7);
            B_2 <= LineColor(to_integer(x_axis), 8);
        end if;
    end process;
    --Update the actual signals
    HsyncClk <= HsyncClk_reg;
    VsyncClk <= VsyncClk_reg;
end architecture;